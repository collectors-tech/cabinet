# Cabinet runtime defaults
CABINET_ADDR=127.0.0.1:17880
CABINET_WEBAUTHN_ORIGIN=http://127.0.0.1:17880

# Optional overrides
# CABINET_DATA_DIR=
# CABINET_DB_PATH=
# CABINET_OPEN_BROWSER=true

# Remote identity (ZITADEL)
# CABINET_AUTH_IDENTITY_MODE=zitadel
# CABINET_ZITADEL_ISSUER=https://identity.example.com
# CABINET_ZITADEL_CLIENT_ID=cabinet-local
# CABINET_ZITADEL_AUDIENCE=cabinet
# CABINET_PUBLIC_ORIGIN=http://127.0.0.1:17880
